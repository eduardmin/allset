commands:
  01_create_swapfile:
    # t3.micro has only 1 GB RAM and no swap by default. Deploys load a new
    # container image while the old JVM is still running, which spikes memory
    # and can hang the instance (OOM). A 2 GB swapfile absorbs that spike and
    # also stabilizes steady-state runtime. Runs early (before the container
    # swap) and is idempotent.
    command: |
      if [ ! -f /var/swapfile ]; then
        /bin/dd if=/dev/zero of=/var/swapfile bs=1M count=2048
        /bin/chmod 600 /var/swapfile
        /sbin/mkswap /var/swapfile
        /sbin/swapon /var/swapfile
        echo '/var/swapfile swap swap defaults 0 0' >> /etc/fstab
      fi
    test: test ! -f /var/swapfile
